# Mangansage — Caddy config untuk Oracle VM
#
# - Otomatis HTTPS via Let's Encrypt kalau {$DOMAIN} domain valid.
# - Kalau {$DOMAIN}=":80" atau kosong → HTTP only (mode testing IP-only).
# - Reverse proxy ke 2 service internal:
#     /app/*, /apps/* → reverb:8080 (WebSocket Pusher protocol)
#     selain itu     → app:8000 (Laravel + FrankenPHP)
#
# Reload tanpa restart container:
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	email {$ACME_EMAIL}
}

{$DOMAIN::80} {
	encode zstd gzip

	# Reverb WebSocket — Pusher protocol pakai path /app/{key} (client) dan /apps/{id} (server API).
	@reverb path /app /app/* /apps /apps/*
	handle @reverb {
		reverse_proxy reverb:8080 {
			transport http {
				read_timeout 86400s
				write_timeout 86400s
			}
		}
	}

	# Avatar / public storage (kalau `php artisan storage:link` sudah dijalankan).
	handle_path /storage/* {
		root * /srv/storage/app/public
		file_server
	}

	# Laravel API + admin web.
	handle {
		reverse_proxy app:8000
	}

	# Logging — JSON ke stdout, di-tail via `docker compose logs -f caddy`.
	log {
		output stdout
		format json
		level INFO
	}
}
