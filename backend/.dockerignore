# File yang TIDAK perlu dikirim ke VM Oracle saat deploy.
# Dipakai oleh `docker build` (di server) dan oleh `deploy.ps1` (untuk tar streaming).

# Dependencies — di-install fresh di container
vendor/
node_modules/

# Local dev artifacts
.env
.env.local
.env.testing
.env.backup
.env.production
.docker/local.env*
.docker/production.env*

# Build artifacts
public/build/
public/hot
public/storage

# Generated cache
bootstrap/cache/*.php
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

# Tests (tidak diperlukan di production)
tests/
phpunit.xml

# Git
.git/
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
.fleet/

# OS
.DS_Store
Thumbs.db

# Documentation (kecuali README di-include)
*.md
!README.md
