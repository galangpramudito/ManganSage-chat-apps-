# ──────────────────────────────────────────────────────────────────────────
# Mangansage — Production env template untuk Oracle Cloud VM
# ──────────────────────────────────────────────────────────────────────────
# Cara pakai:
#   1. Copy file ini → `.env.production` di VM
#   2. Isi semua nilai yang ber-placeholder `<...>`
#   3. JANGAN commit `.env.production` (sudah di .gitignore)
# ──────────────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME=ManganSage
APP_ENV=production
APP_KEY=<GENERATE_DENGAN_php_artisan_key:generate_LALU_PASTE_DI_SINI>
APP_DEBUG=false
APP_URL=https://<YOUR_DOMAIN_OR_IP>
APP_TIMEZONE=Asia/Jakarta

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── Database (Neon Postgres) ─────────────────────────────────────────────
# Pakai endpoint POOLER untuk runtime (pgbouncer-friendly).
# Untuk migration/DDL, pakai endpoint DIRECT (tanpa `-pooler`).
DB_CONNECTION=pgsql
DB_URL=<NEON_POSTGRES_URL_DENGAN_sslmode=require>

# ─── Session ──────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ─── Cache & Queue ────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Broadcasting (Reverb) ────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=<RANDOM_NUMERIC_ID_misal_1001>
REVERB_APP_KEY=<RANDOM_KEY_20_CHARS_alfanumerik>
REVERB_APP_SECRET=<RANDOM_SECRET_40_CHARS_alfanumerik>

# Hostname yang dilihat oleh Flutter client.
# Kalau pakai domain: REVERB_HOST=ws.yourdomain.com (atau domain utama)
# Kalau IP-only:      REVERB_HOST=<VM_PUBLIC_IP>
REVERB_HOST=<YOUR_DOMAIN_OR_IP>
REVERB_PORT=443
REVERB_SCHEME=https

# Internal binding (di dalam container) — JANGAN diubah, ini didelegasikan ke Caddy.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ─── Mail (SMTP) ──────────────────────────────────────────────────────────
# Untuk Gmail: pakai App Password (https://myaccount.google.com/apppasswords)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<YOUR_GMAIL_ADDRESS>
MAIL_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<YOUR_GMAIL_ADDRESS>
MAIL_FROM_NAME="ManganSage"

# ─── FCM (optional — biarkan false kalau belum konfigurasi) ───────────────
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=storage/firebase-credentials.json

# ─── Caddy / HTTPS ────────────────────────────────────────────────────────
# Domain untuk auto-HTTPS via Let's Encrypt.
# Kosongkan / set ":80" untuk mode IP-only HTTP (testing awal).
DOMAIN=<YOUR_DOMAIN>

# Email untuk Let's Encrypt ACME (notif certificate expiry, dll.)
ACME_EMAIL=<YOUR_EMAIL_ADDRESS>
